{
	"name": "@signozhq/design-tokens",
	"version": "2.2.1",
	"type": "module",
	"main": "./dist/design-tokens.js",
	"module": "./dist/design-tokens.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"clean": "rm -rf dist node_modules",
		"update-version": "changeset && changeset version",
		"release": "pnpm build && changeset publish",
		"prepare": "husky install",
		"lint": "eslint . --config eslint.config.js",
		"format": "prettier --write .",
		"fmt": "prettier --check .",
		"type-check": "tsc --noEmit",
		"pre-commit": "lint-staged",
		"generate-tokens": "tsx ./scripts/generate-types-from-json.ts && style-dictionary build && tsx ./scripts/generate-semantic-tokens.ts && tsx ./scripts/generate-typography-styles.ts"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@changesets/cli": "2.31.0",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@eslint/js": "10.0.1",
		"@microsoft/api-extractor": "7.59.2",
		"@types/node": "25.8.0",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"cssnano": "8.0.1",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"husky": "8.0.3",
		"lint-staged": "17.6.0",
		"postcss": "8.5.28",
		"prettier": "3.9.9",
		"style-dictionary": "3.9.2",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"vite": "8.3.1",
		"vite-plugin-dts": "5.1.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SigNoz/design-tokens.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"pnpm": {
		"overrides": {
			"minimatch@<3.1.5": "^3.1.5",
			"flatted@<3.4.2": "^3.4.2",
			"lodash@<4.18.0": "^4.18.1",
			"ajv@>=7.0.0 <8.18.0": "^8.20.0",
			"fast-uri@<3.1.5": "^3.1.5",
			"js-yaml@<3.15.1": "^3.15.1",
			"js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
			"brace-expansion@<1.1.18": "^1.1.18",
			"brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
			"brace-expansion@>=3.0.0 <5.0.9": "^5.0.9",
			"nanoid@<3.3.18": "^3.3.18",
			"svgo@>=4.0.0 <4.0.2": "^4.0.2"
		}
	}
}

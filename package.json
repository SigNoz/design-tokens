{
	"name": "@signozhq/design-tokens",
	"version": "2.1.6",
	"type": "module",
	"main": "./dist/design-tokens.js",
	"module": "./dist/design-tokens.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"clean": "rm -rf dist node_modules",
		"update-version": "changeset && changeset version",
		"release": "pnpm build && changeset publish",
		"prepare": "husky install",
		"lint": "eslint . --config eslint.config.js",
		"format": "prettier --write .",
		"pre-commit": "lint-staged",
		"generate-tokens": "tsx ./scripts/generate-types-from-json.ts && style-dictionary build && tsx ./scripts/generate-semantic-tokens.ts && tsx ./scripts/generate-typography-styles.ts"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@changesets/cli": "2.31.0",
		"@commitlint/cli": "21.0.1",
		"@commitlint/config-conventional": "21.0.1",
		"@eslint/js": "10.0.1",
		"@types/node": "25.7.0",
		"@typescript-eslint/eslint-plugin": "8.59.3",
		"@typescript-eslint/parser": "8.59.3",
		"cssnano": "8.0.1",
		"eslint": "10.3.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.5",
		"husky": "8.0.3",
		"lint-staged": "17.0.4",
		"postcss": "8.5.14",
		"prettier": "3.8.3",
		"style-dictionary": "3.9.2",
		"tsx": "4.22.0",
		"typescript": "6.0.3",
		"vite": "8.0.13",
		"vite-plugin-dts": "5.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}

{
	"name": "@signozhq/design-tokens",
	"version": "2.1.6",
	"type": "module",
	"main": "./dist/design-tokens.js",
	"module": "./dist/design-tokens.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"clean": "rm -rf dist node_modules",
		"update-version": "changeset && changeset version",
		"release": "pnpm build && changeset publish",
		"prepare": "husky install",
		"lint": "eslint . --config eslint.config.js",
		"format": "prettier --write .",
		"pre-commit": "lint-staged",
		"generate-tokens": "tsx ./scripts/generate-types-from-json.ts && style-dictionary build && tsx ./scripts/generate-semantic-tokens.ts && tsx ./scripts/generate-typography-styles.ts"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.8",
		"@commitlint/cli": "^19.5.0",
		"@commitlint/config-conventional": "^19.5.0",
		"@eslint/js": "^8.0.0",
		"@types/node": "^22.5.5",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"cssnano": "^7.0.6",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"husky": "^8.0.0",
		"lint-staged": "^15.5.2",
		"postcss": "^8.5.10",
		"prettier": "^3.0.0",
		"style-dictionary": "3.8.0",
		"tsx": "^4.19.1",
		"typescript": "^5.3.3",
		"vite": "^6.4.2",
		"vite-plugin-dts": "^4.5.4"
	},
	"pnpm": {
		"overrides": {
			"cross-spawn": "7.0.5",
			"esbuild": "^0.25.0",
			"@babel/runtime": "7.26.10",
			"brace-expansion": "^2.0.3",
			"@eslint/plugin-kit": "^0.3.4",
			"tmp": "0.2.4",
			"svgo@>=3.0.0 <3.3.3": "^3.3.3",
			"lodash": "^4.18.1",
			"fast-uri": "^3.1.2",
			"js-yaml@>=4.0.0 <4.1.1": "^4.1.1",
			"ajv@>=7.0.0-alpha.0 <8.18.0": "^8.18.0"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
